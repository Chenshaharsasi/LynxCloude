# ============================================================
# Lynx Studio Content Team — environment variables (template)
# ============================================================
# Copy this file to `.env` and fill in real values.
# Do NOT commit `.env` — it is listed in .gitignore.

# --- Project metadata ---
PROJECT_NAME=lynx-content-team

# --- API keys ---
# Anthropic (Claude) — required for the agent team
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — optional, for image generation (Yuval)
OPENAI_API_KEY=sk-...
